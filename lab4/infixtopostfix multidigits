// Online C++ compiler to run C++ program online
#include <iostream>
#include<stack>
using namespace std;
int getprec(char ch)
{
    if (ch == '+' || ch == '-') return 1;
    else if (ch == '*' || ch == '/') return 2;
    return 0;
}

void infixtopostfix(string exp)
{
    stack<char> st;
    string res = "";
        for(int i=0;i<exp.length();i++){
            if(isdigit(exp[i])){
                while(i<exp.length()&&isdigit(exp[i])){
                    res+=exp[i];
                    i++;
                }
                res+=' ';
                i--;
            }   
        else if (exp[i] == ')')
        {
                while (!st.empty() && st.top() != '(')
                {
                    char top=st.top();
                    res+=top;
                    res+=' ';
                    st.pop();
                }
                if (!st.empty() && st.top() == '(') st.pop();
        }
        else if (exp[i]== '(') st.push(exp[i]);
        else if (exp[i] == '+' || exp[i] == '-' || exp[i]== '*' || exp[i] == '/'){
                int prec = getprec(exp[i]);
                while (!st.empty() && st.top() != '(' && getprec(st.top()) >= prec){
                    char top=st.top();
                    res+=top;
                    res+=' ';
                    st.pop();
                }
                st.push(exp[i]);
            }
        }
    while (!st.empty()) {
       char top=st.top();
       st.pop();
       res+=top;
        res+=' ';
    }
    
    
    cout<<res<<endl;
}
